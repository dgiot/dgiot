{
  "hook_integration": {
    "dgiot_compile_debug": {
      "enabled": true,
      "integration_points": [
        {
          "hook_point": "PreToolUse",
          "action": "check_compile_commands",
          "description": "检查工具使用是否涉及编译调试命令",
          "priority": "MEDIUM"
        },
        {
          "hook_point": "PostToolUse",
          "action": "verify_compile_results",
          "description": "验证编译调试命令的执行结果",
          "priority": "MEDIUM"
        },
        {
          "hook_point": "TaskStart",
          "action": "suggest_compile_workflow",
          "description": "在任务开始时建议编译调试工作流",
          "priority": "LOW"
        },
        {
          "hook_point": "TaskComplete",
          "action": "summarize_compile_debug",
          "description": "在任务完成时总结编译调试活动",
          "priority": "LOW"
        }
      ],
      "compile_commands": [
        "热编译",
        "热加载",
        "在线测试",
        "全量编译",
        "make run",
        "编译调试",
        "dgiot编译",
        "插件调试",
        "热更新",
        "测试套件"
      ],
      "skill_path": "../dgiot_compile_debug",
      "config_file": "config/compile_config.json"
    }
  },
  "hook_execution": {
    "log_level": "INFO",
    "log_file": "logs/dgiot_compile_hook.log",
    "max_log_size_mb": 10,
    "log_retention_days": 7
  },
  "performance": {
    "timeout_seconds": 5,
    "max_memory_mb": 50,
    "enable_profiling": false
  }
}
