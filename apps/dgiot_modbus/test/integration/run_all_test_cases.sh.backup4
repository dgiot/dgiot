#!/bin/bash
#!/bin/bash
# run_all_test_cases.sh - 运行所有测试用例（测试驱动开发）

echo "========================================"
echo "Modbus测试驱动开发 - 运行所有测试用例"
echo "========================================"
echo "开始时间: $(date)"
echo ""

# 颜色输出
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# 日志函数
log_info() { echo -e "${BLUE}[INFO]${NC} $(date '+%Y-%m-%d %H:%M:%S') $*"; }
log_success() { echo -e "${GREEN}[SUCCESS]${NC} $(date '+%Y-%m-%d %H:%M:%S') $*"; }
log_error() { echo -e "${RED}[ERROR]${NC} $(date '+%Y-%m-%d %H:%M:%S') $*" >&2; }

# 测试用例目录
TEST_CASES_DIR="$(dirname "$0")/test_cases"

# 检查测试用例目录
if [ ! -d "$TEST_CASES_DIR" ]; then
    log_error "测试用例目录不存在: $TEST_CASES_DIR"
    exit 1
fi

# 查找所有测试用例脚本
TEST_CASES=($(find "$TEST_CASES_DIR" -name "test_*.sh" -type f | sort))

if [ ${#TEST_CASES[@]} -eq 0 ]; then
    log_error "未找到测试用例脚本"
    exit 1
fi

log_info "找到 ${#TEST_CASES[@]} 个测试用例"

# 测试结果统计
TOTAL_CASES=0
PASSED_CASES=0
FAILED_CASES=0
SKIPPED_CASES=0

# 运行单个测试用例
run_test_case() {
    local test_case="$1"
    local test_name=$(basename "$test_case" .sh)
    
    echo ""
    echo "========================================"
    echo "运行测试用例: $test_name"
    echo "========================================"
    
    # 检查脚本是否可执行
    if [ ! -x "$test_case" ]; then
        log_error "测试用例不可执行: $test_case"
        return 2  # 跳过
    fi
    
    # 运行测试用例
    local start_time=$(date +%s)
    "$test_case"
    local exit_code=$?
    local end_time=$(date +%s)
    local duration=$((end_time - start_time))
    
    # 记录结果
    case $exit_code in
        0)
            log_success "测试用例通过: $test_name (耗时 ${duration}秒)"
            return 0
            ;;
        1)
            log_error "测试用例失败: $test_name (耗时 ${duration}秒)"
            return 1
            ;;
        2)
            log_warning "测试用例跳过: $test_name"
            return 2
            ;;
        *)
            log_error "测试用例异常退出(代码 $exit_code): $test_name"
            return 1
            ;;
    esac
}

# 运行所有测试用例
run_all_test_cases() {
    log_info "开始运行所有测试用例"
    
    for test_case in "${TEST_CASES[@]}"; do
        ((TOTAL_CASES++))
        
        run_test_case "$test_case"
        local result=$?
        
        case $result in
            0) ((PASSED_CASES++)) ;;
            1) ((FAILED_CASES++)) ;;
            2) ((SKIPPED_CASES++)) ;;
        esac
        
        # 短暂暂停，避免日志干扰
        sleep 1
    done
}

# 生成测试报告
generate_test_report() {
    echo ""
    echo "========================================"
    echo "测试报告"
    echo "========================================"
    echo "测试完成时间: $(date)"
    echo ""
    echo "测试用例统计:"
    echo "  总测试用例数: $TOTAL_CASES"
    echo "  通过用例数: $PASSED_CASES"
    echo "  失败用例数: $FAILED_CASES"
    echo "  跳过用例数: $SKIPPED_CASES"
    echo ""
    
    # 计算通过率
    if [ $TOTAL_CASES -gt 0 ]; then
        local pass_rate=$((PASSED_CASES * 100 / TOTAL_CASES))
        echo "  通过率: $pass_rate%"
    fi
    
    # 输出结果
    if [ $FAILED_CASES -eq 0 ]; then
        if [ $SKIPPED_CASES -eq 0 ]; then
            log_success "✅ 所有测试用例通过！"
        else
            log_success "✅ 所有执行的测试用例通过（跳过 $SKIPPED_CASES 个）"
        fi
        return 0
    else
        log_error "❌ 有 $FAILED_CASES 个测试用例失败"
        return 1
    fi
}

# 显示测试用例列表
show_test_cases() {
    echo ""
    echo "可用的测试用例:"
    echo "----------------------------------------"
    
    for test_case in "${TEST_CASES[@]}"; do
        local test_name=$(basename "$test_case" .sh)
        local test_desc=""
        
        # 尝试从脚本中提取测试用例描述
        if [ -f "$test_case" ]; then
            test_desc=$(grep -m1 "^# 测试用例描述" "$test_case" | cut -d: -f2- 2>/dev/null || echo "")
            if [ -z "$test_desc" ]; then
                test_desc=$(grep -m1 "^TEST_CASE_DESCRIPTION=" "$test_case" | cut -d= -f2- | tr -d '"' 2>/dev/null || echo "")
            fi
        fi
        
        echo "  $test_name: ${test_desc:-无描述}"
    done
    
    echo ""
}

# 主函数
main() {
    case "$1" in
        --list|-l)
            show_test_cases
            exit 0
            ;;
        --help|-h)
            echo "用法: $0 [选项]"
            echo ""
            echo "选项:"
            echo "  --list, -l    显示测试用例列表"
            echo "  --help, -h    显示帮助信息"
            echo "  无参数        运行所有测试用例"
            echo ""
            echo "示例:"
            echo "  $0             # 运行所有测试用例"
            echo "  $0 --list      # 显示测试用例列表"
            exit 0
            ;;
        *)
            run_all_test_cases
            generate_test_report
            exit $?
            ;;
    esac
}

# 检查是否在正确目录
if [ ! -f "Makefile.test" ]; then
    log_error "请在apps/dgiot_modbus目录下运行此脚本"
    exit 1
fi

# 运行主函数
main "$@"
