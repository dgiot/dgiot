{
  "tags": [
    {
      "name": "Process",
      "description": "流程管理"
    }
  ],
  "definitions": {},
  "paths": {
    "/process": {
      "get": {
        "description": "获取流程",
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "description": "limit, 显示多少条记录，显示100条记录 eg:100",
            "required": false,
            "default": 10,
            "type": "integer"
          },
          {
            "in": "query",
            "name": "skip",
            "description": "skip",
            "required": false,
            "default": 0,
            "type": "integer"
          },
          {
            "in": "query",
            "name": "type",
            "description": "流程类型，eg: regong,lenggong",
            "required": false,
            "default": "",
            "type": "string"
          },
          {
            "in": "query",
            "name": "where",
            "description": "过滤条件，eg: {\"state\":0}，或者 {\"state\":{\"$ne\":0}}",
            "required": false,
            "default": "{}",
            "type": "string"
          },
          {
            "in": "query",
            "name": "order",
            "description": "排序方式，eg: createdAt,-createdAt",
            "required": false,
            "default": "",
            "type": "string"
          },
          {
            "in": "query",
            "name": "from",
            "description": "来源，除大屏和管理端，都填app",
            "required": false,
            "default": "",
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "Returns operation status"
          },
          "400": {
            "description": "Bad Request"
          },
          "403": {
            "description": "Forbidden"
          },
          "500": {
            "description": "Server Internal error"
          }
        },
        "summary": "获取流程",
        "tags": [
          "Process"
        ]
      },
      "post": {
        "description": "发起流程",
        "parameters": [
          {
            "description": "发起流程",
            "in": "body",
            "name": "data",
            "required": true,
            "schema": {
              "properties": {
                "name": {
                  "description": "流程名称",
                  "type": "string",
                  "example": "冷工作业流程"
                },
                "product": {
                  "description": "流程产品id",
                  "type": "string",
                  "example": "9f668f6a09"
                }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Returns operation status"
          },
          "400": {
            "description": "Bad Request"
          },
          "403": {
            "description": "Forbidden"
          },
          "500": {
            "description": "Server Internal error"
          }
        },
        "summary": "发起流程",
        "tags": [
          "Process"
        ]
      }
    },
    "/process/{id}": {
      "get": {
        "description": "获取流程",
        "parameters": [
          {
            "description": "流程id号",
            "in": "path",
            "name": "id",
            "required": true,
            "default": "CME8XE2gyr",
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "Returns operation status"
          },
          "400": {
            "description": "Bad Request"
          },
          "403": {
            "description": "Forbidden"
          },
          "500": {
            "description": "Server Internal error"
          }
        },
        "summary": "获取流程",
        "tags": [
          "Process"
        ]
      },
      "put": {
        "summary": "审批流程",
        "description": "审批流程",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "type": "string",
            "description": "流程Id",
            "required": true
          },
          {
            "in": "body",
            "name": "data",
            "description": "导入文件信息",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "path": {
                  "description": "文件路径",
                  "type": "string",
                  "example": "{
                      paramList: [
                    {
                          name: name,
                          value: 张三,
                    }
                  ]
                }"
              }
            }
          }
        }
      ],
      "responses": {
        "200": {
          "description": "Returns success"
        },
        "400": {
          "description": "Bad Request"
        },
        "401": {
          "description": "Unauthorized"
        },
        "403": {
          "description": "Forbidden"
        },
        "500": {
          "description": "Server Internal error"
        }
      },
      "tags": [
        "Process"
      ]
    },
    "delete": {
      "description": "撤销流程",
      "parameters": [
        {
          "in": "path",
          "name": "id",
          "type": "string",
          "description": "流程Id",
          "required": true
        }
      ],
      "responses": {
        "200": {
          "description": "Returns operation status"
        },
        "400": {
          "description": "Bad Request"
        },
        "403": {
          "description": "Forbidden"
        },
        "500": {
          "description": "Server Internal error"
        }
      },
      "summary": "撤销流程",
      "tags": [
        "Process"
      ]
    }
  },
  "/process_info": {
    "get": {
      "description": "获取流程产品列表",
      "parameters": [],
      "responses": {
        "200": {
          "description": "Returns operation status"
        },
        "400": {
          "description": "Bad Request"
        },
        "403": {
          "description": "Forbidden"
        },
        "500": {
          "description": "Server Internal error"
        }
      },
      "summary": "获取流程产品列表",
      "tags": [
        "Process"
      ]
    }
  }
}
}