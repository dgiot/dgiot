{application, dgiot_uav, [
    {description, "DG-IoT UAV Test System"},
    {vsn, "4.3.0"},
    {registered, [dgiot_uav_sup]},
    {mod, {dgiot_uav_app, []}},
    {applications, [
        kernel,
        stdlib,
        dgiot
    ]},
    {env, [
        {filter_ascii_registration, true}
    ]},
    {modules, [
        %% 应用核心模块
        dgiot_uav_app,
        dgiot_uav_sup,
        dgiot_uav_handler,
        dgiot_uav_config,
        dgiot_uav_registry,
        
        %% TCP通道模块
        dgiot_uav_tcp_channel,
        dgiot_uav_tcp_worker,
        
        %% UDP通道模块
        dgiot_uav_udp_channel,
        dgiot_uav_udp_worker,
        dgiot_uav_udp_multicast,
        
        %% PLC模块
        dgiot_uav_plc_tcp_channel,
        dgiot_uav_plc_tcp_client,
        dgiot_uav_plc_parser,
        dgiot_uav_plc_business,
        dgiot_uav_plc_utils,
        dgiot_uav_plc_step_executor,
        dgiot_uav_plc_commands,
        dgiot_uav_simple_plc_command,
        
        %% 设备管理模块
        dgiot_uav_device_monitor,
        dgiot_uav_device_manager,
        dgiot_uav_station_manager,
        
        %% 测试管理模块
        dgiot_uav_test_manager,
        dgiot_uav_test_executor,
        dgiot_uav_test_storage,
        dgiot_uav_test_loader,
        dgiot_uav_test_cache_simple,
        dgiot_uav_judge_engine,
        dgiot_uav_auto_tester,
        dgiot_uav_auto_test_coordinator,
        
        %% 业务服务模块
        dgiot_uav_business_service,
        dgiot_uav_command_scheduler,
        dgiot_uav_command_manager,
        dgiot_uav_command_examples,
        dgiot_uav_command_tracer,
        dgiot_uav_command_tracer_simple,
        dgiot_uav_mes_service,
        dgiot_uav_mes_api,
        dgiot_uav_mes_utils,
        dgiot_uav_mes_examples,
        dgiot_uav_report_service,
        dgiot_uav_alarm_manager,
        
        %% 治具模块
        dgiot_fixture_controller,
        dgiot_fixture_commands,
        dgiot_fixture_metrics,
        dgiot_fixture_state_manager,
        dgiot_fixture_test_executor,
        dgiot_uav_fixture_commands,
        
        %% 舵面控制模块
        dgiot_uav_surface_controller,
        uav_surface_service,
        
        %% 协议解析模块
        dgiot_eb90_protocol,
        dgiot_scanner_protocol,
        dgiot_noise_protocol,
        uav_protocol,
        uav_protocol_utils,
        eb90_link_protocol,
        telemetry_protocol,
        payload_protocol,
        control_protocol,
        frame_decoder,
        frame_encoder,
        h264_parser,
        
        %% 数据结构模块
        d1_data,
        d2_data,
        d3_data,
        data_terminal,
        fc_to_payload,
        payload_to_fc,
        link_data,
        uav_payload_checksum,
        
        %% 物模型模块
        auto_thing,
        auto_thing_d1,
        auto_thing_d2,
        auto_thing_d3,
        auto_thing_extra,
        auto_thing_noise,
        auto_thing_surface,
        uav_thing_model,
        uav_thing_model_d1,
        uav_thing_model_d2,
        uav_thing_model_d3,
        uav_thing_model_extra,
        
        %% 工位模块
        station_base,
        station_magnetic_heading,
        
        %% 判据模块
        judge_burn_in_1,
        judge_magnetic_heading,
        
        %% 数据汇聚模块
        dgiot_uav_aggregator,
        dgiot_uav_ground_station_mapper,
        
        %% 工具和诊断模块
        dgiot_quick_diagnosis,
        dgiot_uav_channel_init,
        dgiot_uav_stub_functions,
        dgiot_uav_error_fix,
        uav_error_fix,
        uav_extra_commands,
        
        %% Modbus客户端
        dgiot_modbus_client,
        
        %% 测试项创建
        test_item_creator
    ]},
    {licenses, ["Apache-2.0"]},
    {maintainers, ["DGIOT Team"]},
    {links, [
        {"Homepage", "https://www.dgiotcloud.cn/"},
        {"Github", "https://github.com/dgiot/dgiot"}
    ]}
]}.