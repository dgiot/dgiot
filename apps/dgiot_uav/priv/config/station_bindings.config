%% UAV PLC station address binding config file
%% Format: {Address, StationId, "Description"}
%% Address: PLC register address (e.g., 1400 means D1400)
%% StationId: Station number (1-6)
%% Description: Station name (ASCII string)

{1400, 1, "Hangxingjia Station"}.
{1200, 2, "Burn-in Test 1 Station"}.
{1300, 3, "Burn-in Test 2 Station"}.
{1500, 4, "Final Test 1 Station"}.
{1600, 5, "Final Test 2 Station"}.
{1700, 6, "Magnetic Heading Test Station"}.

