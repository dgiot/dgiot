{
  "system_name": "航天九院 - 无人机自动化检测现场调测系统",
  "version": "1.0.0",
  "description": "无人机自动化检测系统配置",
  "system_config": {
    "name": "无人机自动化检测现场调测系统",
    "version": "1.0.0",
    "environment": "production",
    "debug_mode": false,
    "log_level": "info",
    "timezone": "Asia/Shanghai",
    "language": "zh-CN"
  },
  "network_config": {
    "api_gateway": {
      "host": "localhost",
      "port": 18083,
      "protocol": "http",
      "base_path": "/api/v1"
    },
    "mqtt_broker": {
      "host": "localhost",
      "port": 1883,
      "username": "",
      "password": "",
      "topic_prefix": "dgiot/uav/"
    },
    "database": {
      "tdengine": {
        "host": "localhost",
        "port": 6041,
        "database": "dgiot",
        "username": "root",
        "password": "taosdata"
      },
      "parse_server": {
        "host": "localhost",
        "port": 1337,
        "app_id": "dgiot",
        "master_key": "master_key"
      }
    }
  },
  "station_config": {
    "default_base_address": 1100,
    "check_interval": 1000,
    "timeout": 5000,
    "retry_count": 3,
    "auto_reconnect": true,
    "heartbeat_interval": 30000
  },
  "protocol_config": {
    "uav_protocol": {
      "sync_header": "0xEB90",
      "max_packet_size": 1024,
      "timeout": 3000,
      "retry_count": 2,
      "crc_enabled": true,
      "crc_type": "crc16_modbus"
    },
    "modbus_protocol": {
      "default_slave_id": 1,
      "function_codes": {
        "read_coils": 1,
        "read_discrete_inputs": 2,
        "read_holding_registers": 3,
        "read_input_registers": 4,
        "write_single_coil": 5,
        "write_single_register": 6,
        "write_multiple_coils": 15,
        "write_multiple_registers": 16
      },
      "timeout": 2000,
      "retry_count": 3
    }
  },
  "test_config": {
    "default_test_duration": 300,
    "result_check_interval": 1000,
    "auto_generate_report": true,
    "report_format": "json",
    "data_retention_days": 30,
    "backup_enabled": true,
    "backup_interval": 86400
  },
  "security_config": {
    "authentication": {
      "enabled": true,
      "jwt_secret": "dgiot_uav_secret_key",
      "token_expiry": 86400,
      "refresh_token_expiry": 604800
    },
    "authorization": {
      "rbac_enabled": true,
      "default_role": "operator",
      "roles": ["admin", "engineer", "operator", "viewer"]
    },
    "encryption": {
      "data_encryption": true,
      "algorithm": "aes-256-gcm",
      "key_rotation_days": 30
    }
  },
  "ui_config": {
    "theme": "light",
    "language": "zh-CN",
    "auto_refresh": true,
    "refresh_interval": 5000,
    "chart_update_interval": 1000,
    "max_data_points": 1000,
    "default_view": "dashboard"
  },
  "logging_config": {
    "level": "info",
    "file_enabled": true,
    "file_path": "logs/uav_system.log",
    "file_max_size": "100MB",
    "file_max_files": 10,
    "console_enabled": true,
    "syslog_enabled": false,
    "log_format": "json"
  },
  "monitoring_config": {
    "metrics_enabled": true,
    "metrics_port": 9090,
    "health_check_enabled": true,
    "health_check_interval": 30000,
    "alerting_enabled": true,
    "alert_rules": [
      {
        "name": "high_cpu_usage",
        "condition": "cpu_usage > 80",
        "severity": "warning",
        "action": "send_alert"
      },
      {
        "name": "high_memory_usage",
        "condition": "memory_usage > 85",
        "severity": "warning",
        "action": "send_alert"
      },
      {
        "name": "station_offline",
        "condition": "station_status == 'offline'",
        "severity": "critical",
        "action": "send_alert_and_notify"
      }
    ]
  },
  "backup_config": {
    "enabled": true,
    "schedule": "0 2 * * *",
    "retention_days": 30,
    "storage_type": "local",
    "storage_path": "backups/uav_system",
    "compression": true,
    "encryption": true
  },
  "integration_config": {
    "external_systems": [
      {
        "name": "MES系统",
        "type": "mes",
        "enabled": false,
        "endpoint": "http://mes.example.com/api",
        "sync_interval": 60000
      },
      {
        "name": "ERP系统",
        "type": "erp",
        "enabled": false,
        "endpoint": "http://erp.example.com/api",
        "sync_interval": 3600000
      },
      {
        "name": "SCADA系统",
        "type": "scada",
        "enabled": true,
        "endpoint": "http://scada.example.com/api",
        "sync_interval": 5000
      }
    ]
  },
  "metadata": {
    "created_at": "2026-01-28T03:21:00Z",
    "updated_at": "2026-01-28T03:21:00Z",
    "author": "DGIOT Team",
    "version_notes": "无人机自动化检测系统完整配置，包含网络、协议、测试、安全、UI等配置"
  }
}