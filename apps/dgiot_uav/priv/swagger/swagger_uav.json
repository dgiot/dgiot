{
  "swagger": "2.0",
  "info": {
    "title": "超近距无人机产线指令下发 API",
    "version": "1.0.0",
    "description": "无人机产线指令下发和配置获取接口"
  },
  "host": "127.0.0.1",
  "basePath": "/iotapi",
  "schemes": ["http"],
  "definitions": {
    "UAVResponse": {
      "type": "object",
      "properties": {
        "status": {
          "type": "integer",
          "description": "状态码，0表示成功，1表示失败",
          "example": 0
        },
        "msg": {
          "type": "string",
          "description": "响应消息",
          "example": "指令下发成功"
        },
        "data": {
          "type": "object",
          "properties": {
            "station_id": {
              "type": "integer",
              "description": "工位ID",
              "example": 1500
            },
            "timestamp": {
              "type": "integer",
              "description": "时间戳（毫秒）",
              "example": 1672531200000
            }
          }
        }
      }
    },
    "BatchStep": {
      "type": "object",
      "required": ["object", "instruction_code", "wait_time", "test_item_id", "step_index"],
      "properties": {
        "object": {
          "type": "string",
          "enum": ["PLC", "治具", "无人机"],
          "description": "指令对象类型",
          "example": "PLC"
        },
        "instruction_code": {
          "type": "integer",
          "description": "指令编号（如15表示转速）",
          "example": 15
        },
        "wait_time": {
          "type": "number",
          "format": "float",
          "description": "执行后等待时间（秒）",
          "example": 2.5
        },
        "test_item_id": {
          "type": "string",
          "description": "测试项设备ID",
          "example": "5f8d3b2e1c9d440000"
        },
        "step_index": {
          "type": "integer",
          "description": "步骤序号",
          "example": 1
        }
      }
    },
    "BatchRequest": {
      "type": "object",
      "required": ["devAddr", "steps"],
      "properties": {
        "devAddr": {
          "type": "string",
          "enum": ["D1100", "D1200", "D1300", "D1500", "D1600", "D1700"],
          "description": "工位设备地址",
          "example": "D1500"
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/BatchStep"
          },
          "description": "步骤列表"
        }
      }
    },
    "BatchResponse": {
      "type": "object",
      "properties": {
        "status": {
          "type": "integer",
          "description": "状态码，0成功，1失败",
          "example": 0
        },
        "msg": {
          "type": "string",
          "description": "响应消息",
          "example": "指令集执行完成"
        },
        "data": {
          "type": "object",
          "properties": {
            "executed_steps": {
              "type": "integer",
              "description": "成功执行的步骤数",
              "example": 3
            },
            "results": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "step": {
                    "type": "integer",
                    "description": "步骤序号"
                  },
                  "success": {
                    "type": "boolean",
                    "description": "是否成功"
                  },
                  "message": {
                    "type": "string",
                    "description": "结果消息"
                  }
                }
              }
            }
          }
        }
      }
    },
    "DeviceContent": {
      "type": "object",
      "description": "设备内容，包含测试项步骤",
      "properties": {
        "steps": {
          "type": "array",
          "description": "测试步骤列表",
          "items": {
            "$ref": "#/definitions/TestStep"
          }
        }
      }
    },
    "TestStep": {
      "type": "object",
      "required": ["step_number", "action_type", "description", "target"],
      "properties": {
        "step_number": {
          "type": "integer",
          "description": "步骤序号",
          "example": 1
        },
        "action_type": {
          "type": "string",
          "enum": ["send", "judge"],
          "description": "动作类型",
          "example": "send"
        },
        "description": {
          "type": "string",
          "description": "步骤描述",
          "example": "发送起飞指令"
        },
        "target": {
          "type": "string",
          "enum": ["工位PLC", "治具", "无人机"],
          "description": "目标设备",
          "example": "无人机"
        },
        "send": {
          "type": "object",
          "properties": {
            "content": {
              "type": "string",
              "description": "指令内容或判定结果",
              "example": "15"
            }
          },
          "description": "发送配置"
        },
        "wait": {
          "type": "number",
          "format": "float",
          "description": "等待时间（秒）",
          "example": 2.5
        },
        "receive": {
          "type": "object",
          "description": "接收配置（可选）"
        },
        "notes": {
          "type": "string",
          "description": "备注（可选）"
        }
      }
    }
  },
  "paths": {
    "/uav": {
      "post": {
        "summary": "单步指令下发",
        "security": [],
        "description": "单条指令下发，支持可选的测试项信息",
        "consumes": [
          "application/x-www-form-urlencoded"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "devAddr",
            "in": "formData",
            "type": "string",
            "required": true,
            "description": "设备地址，如 D1500",
            "enum": ["D1100", "D1200", "D1300", "D1500", "D1600", "D1700"],
            "example": "D1500"
          },
          {
            "name": "object",
            "in": "formData",
            "type": "string",
            "required": true,
            "description": "指令对象类型",
            "enum": ["PLC", "治具", "无人机"],
            "example": "PLC"
          },
          {
            "name": "instruction_code",
            "in": "formData",
            "type": "integer",
            "required": true,
            "description": "指令编号",
            "example": 15
          },
          {
            "name": "wait_time",
            "in": "formData",
            "type": "number",
            "format": "float",
            "required": false,
            "description": "执行后等待时间（秒）",
            "example": 2.5
          },
          {
            "name": "test_item_id",
            "in": "formData",
            "type": "string",
            "required": false,
            "description": "测试项设备ID（可选）",
            "example": "5f8d3b2e1c9d440000"
          },
          {
            "name": "step_index",
            "in": "formData",
            "type": "integer",
            "required": false,
            "description": "步骤序号（可选）",
            "example": 1
          }
        ],
        "responses": {
          "200": {
            "description": "指令下发成功",
            "schema": {
              "$ref": "#/definitions/UAVResponse"
            }
          },
          "400": {
            "description": "请求参数错误"
          },
          "500": {
            "description": "服务器内部错误"
          }
        },
        "tags": ["uav"]
      },
      "get": {
        "summary": "获取工位相关信息",
        "security": [],
        "description": "获取不同类型的JSON配置文件",
        "produces": ["application/json"],
        "parameters": [
          {
            "name": "config_type",
            "in": "query",
            "type": "string",
            "required": true,
            "description": "配置类型：InstructionSet、StatusCodes、TestItems、Stations、UAVConfig",
            "enum": ["InstructionSet", "StatusCodes", "TestItems", "Stations", "UAVConfig"],
            "example": "InstructionSet"
          }
        ],
        "responses": {
          "200": {
            "description": "获取配置成功"
          },
          "400": {
            "description": "配置类型错误"
          }
        },
        "tags": ["uav"]
      }
    },
    "/uav/batch": {
      "post": {
        "summary": "批量指令下发",
        "security": [],
        "description": "批量执行多个测试步骤，支持等待时间和测试项信息",
        "consumes": ["application/json"],
        "produces": ["application/json"],
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/BatchRequest"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "批量执行完成",
            "schema": {
              "$ref": "#/definitions/BatchResponse"
            }
          },
          "400": {
            "description": "请求参数错误"
          },
          "500": {
            "description": "服务器内部错误"
          }
        },
        "tags": ["uav"]
      }
    },
    "/amis/Device/{objectId}": {
      "put": {
        "summary": "更新测试项内容",
        "security": [],
        "description": "更新指定设备的 content 字段（用于测试项编辑和新增）",
        "consumes": ["application/json"],
        "produces": ["application/json"],
        "parameters": [
          {
            "name": "objectId",
            "in": "path",
            "type": "string",
            "required": true,
            "description": "设备ID"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "required": ["content"],
              "properties": {
                "content": {
                  "$ref": "#/definitions/DeviceContent"
                }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "更新成功",
            "schema": {
              "type": "object",
              "properties": {
                "status": {
                  "type": "integer",
                  "example": 0
                },
                "msg": {
                  "type": "string",
                  "example": "更新成功"
                }
              }
            }
          },
          "400": {
            "description": "请求参数错误"
          },
          "500": {
            "description": "服务器内部错误"
          }
        },
        "tags": ["amis"]
      }
    }
  },
  "tags": [
    {
      "name": "uav",
      "description": "超近距无人机产线指令下发接口"
    },
    {
      "name": "amis",
      "description": "测试项管理接口"
    }
  ]
}