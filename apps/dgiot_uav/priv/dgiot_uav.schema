%% 工位配置列表 (简化格式，避免cuttlefish解析复杂类型错误)
%% 使用JSON字符串格式存储，在代码中解析
{mapping, "uav.stations", "dgiot_uav.stations", [
    {default, ""},
    {datatype, string},
    {comma_separated_list, false},
    {nullable, true}
]}.

