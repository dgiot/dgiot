%% IP地址配置
{mapping, "uav.magnetic_plc_ip", "dgiot_uav.magnetic_plc_ip", [
    {default, "192.168.100.20"},
    {datatype, string},
    {comma_separated_list, false},
    {nullable, false}
]}.

{mapping, "uav.magnetic_dtu_ip", "dgiot_uav.magnetic_dtu_ip", [
    {default, "192.168.100.21"},
    {datatype, string},
    {comma_separated_list, false},
    {nullable, false}
]}.

{mapping, "uav.shared_ip", "dgiot_uav.shared_ip", [
    {default, "192.168.100.40"},
    {datatype, string},
    {comma_separated_list, false},
    {nullable, false}
]}.

{mapping, "uav.fixture_prefix", "dgiot_uav.fixture_prefix", [
    {default, "192.168.100."},
    {datatype, string},
    {comma_separated_list, false},
    {nullable, false}
]}.

