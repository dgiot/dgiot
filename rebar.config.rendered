{xref_ignores,[{emqx_schema_registry,get_all_schemas,0},
               {emqx_schema_api,format_schema,1},
               {emqx_schema_api,make_schema_params,1},
               {emqx_schema_parser,decode,3},
               {emqx_schema_parser,encode,3},
               {emqx_schema_registry,add_schema,1},
               emqx_exhook_pb,emqx_exproto_pb]}.
{overrides,[{add,[{extra_src_dirs,[{"etc",[{recursive,true}]}]},
                  {erl_opts,[{compile_info,[{emqx_vsn,"4.9.1-d57601e5"}]}]}]},
            {add,relx,[{erl_opts,[{d,'RLX_LOG',rlx_log}]}]},
            {add,snabbkaffe,
                 [{erl_opts,[debug_info,
                             {compile_info,[{emqx_vsn,"4.9.1-d57601e5"}]},
                             {d,snk_kind,msg}]}]}]}.
{xref_ignores,[emqx_misc,dgiot_broker_emqx,dgiot_metrics_adapter,dgiot_mqtt]}.
